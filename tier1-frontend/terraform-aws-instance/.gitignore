# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data.
# Secret variables should be managed through other means, such as
# environment variables or dedicated secret management systems.
*.tfvars
*.tfvars.json

# Ignore override files, which are often used for local development and testing
# but not intended for version control.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by 'terraform graph'
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout